# Herbalist AI Production Environment Configuration
PORT=8000
ENVIRONMENT=production

# Server-side Google Gemini API Key (keep secret, do NOT commit actual key here)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Whitelist (comma-separated origins, or * for development)
CORS_ALLOWED_ORIGINS=*

# Enterprise Distributed Session Cache (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Enterprise Vector Database (Qdrant Cloud)
QDRANT_URL=https://your-qdrant-cluster-url.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Email Delivery Service (Resend API or SMTP Server for Real Email OTP)
# RESEND_API_KEY=your_resend_api_key_here
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM_EMAIL=noreply@herbalist.ai


